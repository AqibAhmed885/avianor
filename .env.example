# Environment Variables — Avianor Engineering

# ─────────────────────────────────────────────
# SITE CONFIGURATION
# ─────────────────────────────────────────────

# The canonical production URL (no trailing slash)
# Replace before deployment
NEXT_PUBLIC_SITE_URL=https://www.avianorengineering.com

# ─────────────────────────────────────────────
# CONTACT FORM
# ─────────────────────────────────────────────

# Set to "mock" during development (logs to console, does NOT send email)
# Set to "resend" to use the Resend email provider
# Set to "sendgrid" to use SendGrid
CONTACT_EMAIL_PROVIDER=mock

# The address where contact form submissions are delivered
CONTACT_TO_EMAIL=hello@avianorengineering.com

# Resend — https://resend.com
# Required when CONTACT_EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SendGrid — https://sendgrid.com
# Required when CONTACT_EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# The "From" address used when sending form submissions
# Must be verified in your email provider
CONTACT_FROM_EMAIL=noreply@avianorengineering.com

# ─────────────────────────────────────────────
# RATE LIMITING (optional)
# ─────────────────────────────────────────────

# Upstash Redis for rate-limiting the contact form
# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

